<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(MosaicTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>false</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Condition="'$(MosaicPortable)' != 'true'">
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.11" />
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>

  <!--
    Portable (non-Windows) build: leave out the Win32, WinRT, WASAPI and WMI implementations.
    Their interfaces stay in Core; another platform supplies its own implementations.
  -->
  <ItemGroup Condition="'$(MosaicPortable)' == 'true'">
    <Compile Remove="Services/Windows*.cs" />
    <Compile Remove="Services/BrowserUi/WindowsBrowserUi.cs" />
    <Compile Remove="HostPlatform/WindowsAudioEndpointPolicy.cs" />
    <AdditionalFiles Remove="NativeMethods.txt;NativeMethods.json" />
  </ItemGroup>

  <!--
    Linux services (MPRIS over D-Bus). Tmds.DBus.Protocol is the version Avalonia.FreeDesktop already ships, so the
    Host carries one copy. The Windows build leaves Services/Linux out entirely.
  -->
  <ItemGroup Condition="'$(MosaicPortable)' == 'true'">
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(MosaicPortable)' != 'true'">
    <Compile Remove="Services/Linux/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MosaicShell.Core.Tests" />
  </ItemGroup>

</Project>
