<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MosaicShell.Host.ViewModels"
        xmlns:views="using:MosaicShell.Host.Views"
        xmlns:tessera="using:MosaicShell.Host.Tiles.Tessera"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
        x:Class="MosaicShell.Host.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainViewModel"
        Width="1100" Height="750"
        MinWidth="780" MinHeight="560"
        CanMaximize="False"
        chrome:WindowDrawnDecorations.TitleBarDecorations="Title, MinimizeButton, CloseButton"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        ExtendClientAreaToDecorationsHint="True"
        Icon="avares://MosaicShell.Host/Assets/mosaicshell.ico"
        Title="MosaicShell">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Left rail: one button per destination, the open one highlighted. -->
    <Style Selector="Button.rail">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Button.rail:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.rail.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="Button.rail.selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- A list row: one Button across the row, a quiet card that lights on hover and press. -->
    <Style Selector="Button.listRow">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    </Style>
    <Style Selector="Button.listRow:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
    </Style>
    <!-- On, Off or Not added beside each row; On in the accent colour so it reads at a glance. -->
    <Style Selector="Border.stateChip">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Border.stateChip > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Border.stateChip.on">
      <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style Selector="Border.stateChip.on > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.groupHeading">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Setter Property="Margin" Value="2,6,0,0" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon /template/ ContentPresenter">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.accentSwatch">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.accentSwatch:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.accentSwatch.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <!-- Home cards and library row bodies are real Buttons (focus, keyboard, automation, pressed state). -->
    <Style Selector="Button.card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.card:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
    </Style>
    <!-- A library row: one Button the size of the card, behind the row's content (see the row template). -->
    <Style Selector="Button.libraryRow">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.libraryRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.libraryRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Margin" Value="0,0,0,14" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.sectionHint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <!-- Motion looks -->
    <Style Selector="Button.motionCard">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <Style Selector="Button.motionCard /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.motionCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.motionCard Border.motionFace">
      <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Button.motionCard:pointerover Border.motionFace">
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
    </Style>
    <Style Selector="Button.motionCard Border.motionFace.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="RadioButton.motionDir">
      <Setter Property="MinWidth" Value="84" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <!-- Readable NumericUpDown sizing -->
    <Style Selector="NumericUpDown.config">
      <Setter Property="MinWidth" Value="168" />
      <Setter Property="Width" Value="180" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="ShowButtonSpinner" Value="True" />
      <Setter Property="AllowSpin" Value="True" />
    </Style>
    <Style Selector="NumericUpDown.config /template/ TextBox#PART_TextBox">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
  </Window.Styles>

  <Grid Margin="0,28,0,0" ColumnDefinitions="Auto,*">
    <!-- The rail: Home, Modules, Widgets, then Settings and About. -->
    <Border Grid.Column="0" Width="{Binding RailWidth}" Padding="8,8,8,12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
      <!-- Rows in reading order, so Tab goes Home, Modules, Widgets, Settings, About. -->
      <Grid x:Name="Rail" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="8,4,0,14">
          <Image Source="avares://MosaicShell.Host/Assets/MosaicShell.png" Width="26" Height="26"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="MosaicShell" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" IsVisible="{Binding !IsRailCollapsed}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="2">
          <Button Classes="rail" Classes.selected="{Binding IsHome}" Command="{Binding NavigateCommand}" CommandParameter="Home"
                  AutomationProperties.Name="Home" ToolTip.Tip="Home">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <icons:MaterialIcon Kind="HomeOutline" Width="20" Height="20" />
              <TextBlock Text="Home" VerticalAlignment="Center" IsVisible="{Binding !IsRailCollapsed}" />
            </StackPanel>
          </Button>
          <Button Classes="rail" Classes.selected="{Binding IsModulesRailSelected}" Command="{Binding NavigateCommand}" CommandParameter="Modules"
                  AutomationProperties.Name="Modules" ToolTip.Tip="Modules">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <icons:MaterialIcon Kind="PuzzleOutline" Width="20" Height="20" />
              <TextBlock Text="Modules" VerticalAlignment="Center" IsVisible="{Binding !IsRailCollapsed}" />
            </StackPanel>
          </Button>
          <Button Classes="rail" Classes.selected="{Binding IsWidgetsRailSelected}" Command="{Binding NavigateCommand}" CommandParameter="Widgets"
                  AutomationProperties.Name="Widgets" ToolTip.Tip="Widgets">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <icons:MaterialIcon Kind="ViewDashboardOutline" Width="20" Height="20" />
              <TextBlock Text="Widgets" VerticalAlignment="Center" IsVisible="{Binding !IsRailCollapsed}" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="2">
          <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="4,8" />
          <Button Classes="rail" Classes.selected="{Binding IsSettings}" Command="{Binding NavigateCommand}" CommandParameter="Settings"
                  AutomationProperties.Name="Settings" ToolTip.Tip="Settings">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <icons:MaterialIcon Kind="CogOutline" Width="20" Height="20" />
              <TextBlock Text="Settings" VerticalAlignment="Center" IsVisible="{Binding !IsRailCollapsed}" />
            </StackPanel>
          </Button>
          <Button Classes="rail" Classes.selected="{Binding IsAbout}" Command="{Binding NavigateCommand}" CommandParameter="About"
                  AutomationProperties.Name="About" ToolTip.Tip="About">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <icons:MaterialIcon Kind="InformationOutline" Width="20" Height="20" />
              <TextBlock Text="About" VerticalAlignment="Center" IsVisible="{Binding !IsRailCollapsed}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Pages -->
    <!-- Arrow keys move between the cards and controls on a page by where they sit (XY focus). -->
    <Grid x:Name="Pages" Grid.Column="1" ClipToBounds="True" XYFocus.NavigationModes="Keyboard">
      <Grid IsVisible="{Binding !IsSettings}" Margin="40,20"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <!-- Home: the welcome, then what is running now -->
          <ScrollViewer IsVisible="{Binding IsHome}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Image Source="avares://MosaicShell.Host/Assets/MosaicShell.png" Width="48" Height="48"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Home" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <TextBlock Text="Your desktop, composed." Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="14" />
                </StackPanel>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" LineHeight="22" MaxWidth="720" HorizontalAlignment="Left"
                         Text="Pick what you want from Modules and Widgets. Modules run in the background, like Tessera's volume and media pop-ups or the Mixdeck mixer: turn them on and they work by themselves. Widgets sit on the desktop." />
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="13" LineHeight="20" MaxWidth="720" HorizontalAlignment="Left"
                         Text="{Binding CloseHint}" />

              <Border Classes="section" Padding="16,12" IsVisible="{Binding HasUpdateBanner}" Margin="0,8,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <icons:MaterialIcon Kind="Download" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="1" Text="{Binding UpdateBanner}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <Button Grid.Column="2" Classes="accent" Content="Install" Command="{Binding CheckUpdatesCommand}" />
                </Grid>
              </Border>

              <TextBlock Classes="sectionTitle" Text="Running now" Margin="0,16,0,0" />
              <TextBlock Text="Nothing is on. Turn something on from Modules or Widgets." IsVisible="{Binding HasNothingRunning}"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              <TextBlock Classes="groupHeading" Text="Modules" IsVisible="{Binding HasRunningBackground}" />
              <ItemsControl ItemsSource="{Binding Modules}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LibraryItemViewModel">
                    <Grid IsVisible="{Binding IsOnHome}">
                      <Button Classes="listRow"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenModuleCommand}" CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding SettingsAutomationName}">
                        <Grid ColumnDefinitions="Auto,*,Auto,72">
                          <icons:MaterialIcon Kind="{Binding GlyphKind}" Width="22" Height="22" Foreground="{Binding GlyphBrush}"
                                              VerticalAlignment="Center" Margin="0,0,14,0" />
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding StatusLine}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                          </StackPanel>
                          <icons:MaterialIcon Grid.Column="2" Kind="AlertCircle" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"
                                              Foreground="{DynamicResource SystemFillColorCautionBrush}" IsVisible="{Binding IsProblem}" />
                        </Grid>
                      </Button>
                      <!-- A quick switch above the row button, so it takes its own click. Off keeps the row where it is;
                           the switch itself shows the state. -->
                      <ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                    OnContent="" OffContent="" IsChecked="{Binding IsOn, Mode=OneWay}"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).ToggleOnHomeCommand}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="groupHeading" Text="Widgets" IsVisible="{Binding HasRunningDesktop}" />
              <ItemsControl ItemsSource="{Binding Widgets}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LibraryItemViewModel">
                    <Grid IsVisible="{Binding IsOnHome}">
                      <Button Classes="listRow"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenModuleCommand}" CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding SettingsAutomationName}">
                        <Grid ColumnDefinitions="Auto,*,Auto,72">
                          <icons:MaterialIcon Kind="{Binding GlyphKind}" Width="22" Height="22" Foreground="{Binding GlyphBrush}"
                                              VerticalAlignment="Center" Margin="0,0,14,0" />
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding StatusLine}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                          </StackPanel>
                          <icons:MaterialIcon Grid.Column="2" Kind="AlertCircle" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"
                                              Foreground="{DynamicResource SystemFillColorCautionBrush}" IsVisible="{Binding IsProblem}" />
                        </Grid>
                      </Button>
                      <!-- A quick switch above the row button, so it takes its own click. Off keeps the row where it is;
                           the switch itself shows the state. -->
                      <ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                    OnContent="" OffContent="" IsChecked="{Binding IsOn, Mode=OneWay}"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).ToggleOnHomeCommand}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!-- First run (U25): the modules that were set up, already on, each with its switch, then Done. -->
          <ScrollViewer IsVisible="{Binding IsFirstRunPage}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Image Source="avares://MosaicShell.Host/Assets/MosaicShell.png" Width="48" Height="48"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="MosaicShell is ready" FontSize="28" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <TextBlock Text="These modules are on. Turn any off now, or change them later on the Modules page."
                             FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </StackPanel>
              <TextBlock IsVisible="{Binding !HasInstalledModules}" TextWrapping="Wrap" FontSize="14"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Text="Nothing could be added yet. Add modules from the Modules page." />
              <ItemsControl ItemsSource="{Binding InstalledModules}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LibraryItemViewModel">
                    <Border CornerRadius="8" Padding="16,12" BorderThickness="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <icons:MaterialIcon Kind="{Binding GlyphKind}" Width="22" Height="22" Foreground="{Binding GlyphBrush}"
                                            VerticalAlignment="Center" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                          <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Show it on screen" Margin="0,0,12,0" VerticalAlignment="Center"
                                IsVisible="{Binding IsCapability}"
                                AutomationProperties.Name="{Binding Name, StringFormat=Show {0} on screen}"
                                Command="{Binding #Root.((vm:MainViewModel)DataContext).PreviewModuleCommand}" CommandParameter="{Binding}" />
                        <ToggleSwitch Grid.Column="3" VerticalAlignment="Center" OnContent="" OffContent=""
                                      IsChecked="{Binding IsOn, Mode=OneWay}" AutomationProperties.Name="{Binding Name}"
                                      Command="{Binding #Root.((vm:MainViewModel)DataContext).ToggleModuleOnCommand}" CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding CloseHint}" FontSize="13" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              <Button Classes="accent" Content="Done" MinWidth="120" HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                      Command="{Binding FinishFirstRunCommand}" />
            </StackPanel>
          </ScrollViewer>

          <!-- Modules: every one, sorted by state -->
          <DockPanel IsVisible="{Binding IsModulesList}">
            <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,14" MaxWidth="820" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Modules" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <!-- A third-party package: a folder or .zip with module.manifest.json. Its Kind decides its list. -->
                <Button Grid.Column="1" Content="Add from file…" VerticalAlignment="Center" IsEnabled="{Binding !IsBusy}"
                        AutomationProperties.Name="Add a module from a file">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="A .zip package…" Click="OnAddPackageZipClicked" />
                      <MenuItem Header="A folder…" Click="OnAddPackageFolderClicked" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
              <TextBlock Text="Modules run in the background. Every module is here, the ones on first." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <TextBox Text="{Binding LibrarySearch}" PlaceholderText="{Binding LibrarySearchPlaceholder}"
                       AutomationProperties.Name="{Binding LibrarySearchPlaceholder}" Classes="librarySearch">
                <TextBox.InnerLeftContent>
                  <icons:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="10,0,0,0"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </TextBox.InnerLeftContent>
                <TextBox.InnerRightContent>
                  <Button Classes="icon" Margin="0,0,4,0" Padding="4" IsVisible="{Binding HasLibrarySearch}"
                          Command="{Binding ClearLibrarySearchCommand}" AutomationProperties.Name="Clear search" ToolTip.Tip="Clear search">
                    <icons:MaterialIcon Kind="Close" Width="14" Height="14" />
                  </Button>
                </TextBox.InnerRightContent>
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Escape" Command="{Binding ClearLibrarySearchCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Modules}" MaxWidth="820" HorizontalAlignment="Stretch" Margin="0,0,8,8">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LibraryItemViewModel">
                    <Grid IsVisible="{Binding IsShownBySearch}">
                      <!-- The row opens the page (for one not added, its page offers the switch that adds it). -->
                      <Button Classes="listRow"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenModuleCommand}" CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding SettingsAutomationName}">
                        <Grid ColumnDefinitions="Auto,*,Auto,140">
                          <icons:MaterialIcon Kind="{Binding GlyphKind}" Width="22" Height="22" Foreground="{Binding GlyphBrush}"
                                              VerticalAlignment="Center" Margin="0,0,14,0" />
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                              <Border Classes="stateChip" Padding="6,0" Margin="0" IsVisible="{Binding IsThirdParty}" VerticalAlignment="Center">
                                <TextBlock Text="Third-party" FontSize="11" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ListLine}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                          </StackPanel>
                          <Border Grid.Column="2" Classes="stateChip" Classes.on="{Binding IsStateOn}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StateLabel}" FontSize="12" />
                          </Border>
                        </Grid>
                      </Button>
                      <!-- One action, above the row button so it takes its own click. -->
                      <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" MinWidth="110"
                              HorizontalContentAlignment="Center"
                              Classes.accent="{Binding !IsInstalled}" IsEnabled="{Binding !IsInstalling}"
                              Content="{Binding RowActionLabel}" AutomationProperties.Name="{Binding RowActionAutomationName}"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).RowActionCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>

          <!-- Widgets: every one, sorted by state -->
          <DockPanel IsVisible="{Binding IsWidgetsList}">
            <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,14" MaxWidth="820" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Widgets" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <!-- A third-party package: a folder or .zip with module.manifest.json. Its Kind decides its list. -->
                <Button Grid.Column="1" Content="Add from file…" VerticalAlignment="Center" IsEnabled="{Binding !IsBusy}"
                        AutomationProperties.Name="Add a module from a file">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="A .zip package…" Click="OnAddPackageZipClicked" />
                      <MenuItem Header="A folder…" Click="OnAddPackageFolderClicked" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
              <TextBlock Text="Widgets sit on the desktop. Every widget is here, the ones on first." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <TextBox Text="{Binding LibrarySearch}" PlaceholderText="{Binding LibrarySearchPlaceholder}"
                       AutomationProperties.Name="{Binding LibrarySearchPlaceholder}" Classes="librarySearch">
                <TextBox.InnerLeftContent>
                  <icons:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="10,0,0,0"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </TextBox.InnerLeftContent>
                <TextBox.InnerRightContent>
                  <Button Classes="icon" Margin="0,0,4,0" Padding="4" IsVisible="{Binding HasLibrarySearch}"
                          Command="{Binding ClearLibrarySearchCommand}" AutomationProperties.Name="Clear search" ToolTip.Tip="Clear search">
                    <icons:MaterialIcon Kind="Close" Width="14" Height="14" />
                  </Button>
                </TextBox.InnerRightContent>
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Escape" Command="{Binding ClearLibrarySearchCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Widgets}" MaxWidth="820" HorizontalAlignment="Stretch" Margin="0,0,8,8">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LibraryItemViewModel">
                    <Grid IsVisible="{Binding IsShownBySearch}">
                      <!-- The row opens the page (for one not added, its page offers the switch that adds it). -->
                      <Button Classes="listRow"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenModuleCommand}" CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding SettingsAutomationName}">
                        <Grid ColumnDefinitions="Auto,*,Auto,140">
                          <icons:MaterialIcon Kind="{Binding GlyphKind}" Width="22" Height="22" Foreground="{Binding GlyphBrush}"
                                              VerticalAlignment="Center" Margin="0,0,14,0" />
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                              <Border Classes="stateChip" Padding="6,0" Margin="0" IsVisible="{Binding IsThirdParty}" VerticalAlignment="Center">
                                <TextBlock Text="Third-party" FontSize="11" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ListLine}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                          </StackPanel>
                          <Border Grid.Column="2" Classes="stateChip" Classes.on="{Binding IsStateOn}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StateLabel}" FontSize="12" />
                          </Border>
                        </Grid>
                      </Button>
                      <!-- One action, above the row button so it takes its own click. -->
                      <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" MinWidth="110"
                              HorizontalContentAlignment="Center"
                              Classes.accent="{Binding !IsInstalled}" IsEnabled="{Binding !IsInstalling}"
                              Content="{Binding RowActionLabel}" AutomationProperties.Name="{Binding RowActionAutomationName}"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).RowActionCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>

        <!-- Module config (from tile cog) -->
        <DockPanel IsVisible="{Binding IsModuleConfig}">
          <TextBlock DockPanel.Dock="Top" Margin="0,0,0,16" FontSize="28" FontWeight="SemiBold"
                     Text="{Binding ConfigModuleTitle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

          <!-- Tessera vs other modules (single fill slot, avoids DockPanel starving Tessera) -->
          <Grid>

          <!-- Modules with a Core schema: one generic page, every change applied as it is made -->
          <Panel IsVisible="{Binding HasModulePage}">
            <views:ModulePageView DataContext="{Binding ModulePage}" />
          </Panel>

          <!-- A module with neither a page nor styles in its manifest: what it does, and nothing to set -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="!ShowTesseraExtras" />
                <Binding Path="!HasModulePage" />
              </MultiBinding>
            </ScrollViewer.IsVisible>
            <Border Classes="section" VerticalAlignment="Top" Margin="0,0,8,8">
              <StackPanel Spacing="8">
                <TextBlock Classes="sectionTitle" Text="What this does" Margin="0" />
                <TextBlock Text="{Binding ConfigUsageSummary}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14" />
                <TextBlock Text="{Binding ConfigHowToTrigger}" TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="13" />
                <TextBlock Text="It has no settings to change here." TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
              </StackPanel>
            </Border>
          </ScrollViewer>
          </Grid>
        </DockPanel>

        <!-- About -->
        <StackPanel IsVisible="{Binding IsAbout}" Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <Image Source="avares://MosaicShell.Host/Assets/MosaicShell.png" Width="72" Height="72"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="MosaicShell" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              <TextBlock Text="Your desktop, composed." Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="14" />
              <TextBlock Text="{Binding HostBuildLabel, StringFormat=Build {0}}"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" LineHeight="22"
                     Text="{x:Static vm:PlatformTexts.About}" />
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" LineHeight="22"
                     Text="Built as an Avalonia rewrite of the JaxCore / Rainmeter era, with the same idea of composable surfaces, without Rainmeter or .rmskin installs. The built-in modules ship with MosaicShell, and others can be added from a file; widgets are native windows on your desktop." />
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="13" LineHeight="20"
                     Text="Honest about fidelity: flagship layouts work; pixel-perfect Jax-Core parity is still iterative. Issues and modules welcome on GitHub." />
          <Button Content="View on GitHub" HorizontalAlignment="Left"
                  Command="{Binding OpenGitHubCommand}" />
        </StackPanel>
        </Grid>

      <DockPanel IsVisible="{Binding IsSettings}" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="40,8,40,16">
        <Image Source="avares://MosaicShell.Host/Assets/MosaicShell.png" Width="40" Height="40"
               RenderOptions.BitmapInterpolationMode="HighQuality" />
        <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   VerticalAlignment="Center" />
      </StackPanel>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalAlignment="Stretch">
        <!--
          One box for every setting, grouped by headings and dividers, scrolled by this page's ScrollViewer. Sections in
          the order people need them (HubSettingsLayout): General, Updates, Browser media, then Diagnostics folded.
        -->
        <Border Classes="section" Margin="40,0,40,16" MaxWidth="820" HorizontalAlignment="Left">
          <StackPanel Spacing="16">

            <!-- General -->
            <StackPanel Spacing="12">
              <TextBlock Classes="sectionTitle" Text="General" />

              <StackPanel Spacing="6">
                <TextBlock Text="When I close this window" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <RadioButton GroupName="HubClose" IsChecked="{Binding CloseMinimizesToTray, Mode=OneWay}"
                             Command="{Binding SetCloseMinimizesToTrayCommand}" CommandParameter="tray">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding KeepRunningChoice.Label}" />
                    <TextBlock Text="{Binding KeepRunningChoice.Consequence}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                </RadioButton>
                <RadioButton GroupName="HubClose" IsChecked="{Binding !CloseMinimizesToTray, Mode=OneWay}"
                             Command="{Binding SetCloseMinimizesToTrayCommand}" CommandParameter="exit">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding QuitChoice.Label}" />
                    <TextBlock Text="{Binding QuitChoice.Consequence}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>

              <StackPanel Spacing="4">
                <ToggleSwitch Content="Start MosaicShell when I sign in"
                              IsChecked="{Binding AutostartEnabled, Mode=OneWay}"
                              Command="{Binding ToggleAutostartCommand}" />
                <TextBlock Classes="sectionHint" Margin="0" Text="{x:Static vm:PlatformTexts.Autostart}" />
              </StackPanel>

              <StackPanel Spacing="4">
                <ToggleSwitch Content="Reduce motion when my system does"
                              IsChecked="{Binding FollowSystemReducedMotion}" />
                <TextBlock Classes="sectionHint" Margin="0" TextWrapping="Wrap"
                           Text="When on, and your system's animation effects are off, pop-ups fade in place instead of sliding, motion previews hold still, and buttons do not move when pressed." />
                <TextBlock Classes="sectionHint" Margin="0" TextWrapping="Wrap" Text="{Binding ReducedMotionStatus}" />
              </StackPanel>
            </StackPanel>

            <Separator />

            <!-- Updates -->
            <StackPanel Spacing="10">
              <TextBlock Classes="sectionTitle" Text="Updates" />
              <TextBlock Classes="sectionHint" Margin="0" TextWrapping="Wrap" Text="{Binding UpdateHint}" />
              <TextBlock Text="{Binding HostBuildLabel, StringFormat=Installed: {0}}"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Check for updates" Command="{Binding CheckUpdatesCommand}" />
                <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>

            <Separator />

            <!-- Browser media -->
            <StackPanel Spacing="10">
              <TextBlock Classes="sectionTitle" Text="Browser media" />
              <TextBlock Classes="sectionHint" Margin="0" TextWrapping="Wrap"
                         Text="Grout, MosaicShell's browser extension, gives the media pop-up the real title, artist and cover from YouTube Music, YouTube, Spotify and SoundCloud, and lets the heart and thumbs-down work." />
              <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- A status light: green and glowing while Grout is connected, red while it is not. -->
                <Panel Width="12" Height="12" Margin="2,0,12,0" VerticalAlignment="Center">
                  <Border Width="12" Height="12" CornerRadius="6" IsVisible="{Binding IsGroutConnected}"
                          Background="#22C55E" BoxShadow="0 0 8 2 #8022C55E"
                          AutomationProperties.Name="Grout connected" />
                  <Border Width="12" Height="12" CornerRadius="6" IsVisible="{Binding IsGroutDisconnected}"
                          Background="#EF4444" BoxShadow="0 0 8 2 #80EF4444"
                          AutomationProperties.Name="Grout not connected" />
                </Panel>
                <TextBlock Grid.Column="1" Text="{Binding BrowserMediaStatus}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Button Grid.Column="2" Content="Get Grout" Margin="12,0,0,0" IsVisible="{Binding OffersGroutInstall}"
                        Command="{Binding OpenGroutCommand}" />
              </Grid>
            </StackPanel>

            <Separator />

            <!-- Diagnostics: for reporting a problem, folded until wanted -->
            <Expander Header="Diagnostics" HorizontalAlignment="Stretch" Background="Transparent" IsExpanded="False">
              <StackPanel Spacing="14" Margin="0,8,0,0">
                <StackPanel Spacing="6">
                  <TextBlock Text="Data folder" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <TextBlock Classes="sectionHint" Margin="0" Text="Settings, modules and saved window positions." />
                  <Grid ColumnDefinitions="*,Auto">
                    <SelectableTextBlock Text="{Binding DataFolderPath}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"
                                         FontFamily="Cascadia Mono, Consolas, monospace" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Open folder" Margin="12,0,0,0" Click="OnOpenDataFolderClicked" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Text="Logs" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <TextBlock Classes="sectionHint" Margin="0" Text="Attach these to a bug report." />
                  <Grid ColumnDefinitions="*,Auto">
                    <SelectableTextBlock Text="{Binding LogFolderPath}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"
                                         FontFamily="Cascadia Mono, Consolas, monospace" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Open folder" Margin="12,0,0,0" Click="OnOpenLogFolderClicked" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Text="Services" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <TextBlock Classes="sectionHint" Margin="0" Text="What MosaicShell reads from the system right now." />
                  <SelectableTextBlock Text="{Binding ServiceProbe}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />
                </StackPanel>
              </StackPanel>
            </Expander>

          </StackPanel>
        </Border>
      </ScrollViewer>
      </DockPanel>

      <!-- Remove confirmation, only for modules MosaicShell cannot bring back (ModuleRemovalPolicy.ConfirmFirst). -->
      <Border IsVisible="{Binding HasPendingRemoval}"
              Background="{DynamicResource SmokeFillColorDefaultBrush}">
        <Border Classes="section" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="12">
            <TextBlock Classes="sectionTitle" Text="{Binding PendingRemovalTitle}" />
            <TextBlock Text="{Binding PendingRemovalBody}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="Cancel" IsCancel="True" Command="{Binding CancelRemoveCommand}" />
              <Button Classes="accent" Content="Remove" Command="{Binding ConfirmRemoveCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>

      <!-- Toast: what just happened, with Undo when it can be undone. -->
      <Border IsVisible="{Binding IsToastVisible}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,20"
              MaxWidth="640" Padding="16,10" CornerRadius="8" BorderThickness="1"
              Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BoxShadow="0 4 16 0 #40000000">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Text="{Binding ToastMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <Button Grid.Column="1" Content="{Binding UndoLabel}" Margin="12,0,0,0" IsVisible="{Binding ToastHasUndo}"
                  Command="{Binding UndoRemoveCommand}" />
          <Button Grid.Column="2" Classes="icon" Margin="8,0,0,0" Command="{Binding DismissToastCommand}"
                  AutomationProperties.Name="Dismiss" ToolTip.Tip="Dismiss">
            <icons:MaterialIcon Kind="Close" Width="14" Height="14" />
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>