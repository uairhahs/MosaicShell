<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MosaicShell.Host.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
        x:Class="MosaicShell.Host.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainViewModel"
        Width="1100" Height="750"
        MinWidth="780" MinHeight="560"
        Background="#11111b"
        ExtendClientAreaToDecorationsHint="True"
        Icon="/Assets/mosaicshell.ico"
        Title="MosaicShell">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#a6adc8" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#313244" />
      <Setter Property="Foreground" Value="#cdd6f4" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#45475a" />
      <Setter Property="Foreground" Value="#cdd6f4" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Background" Value="#313244" />
      <Setter Property="Foreground" Value="#cdd6f4" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.action:pointerover">
      <Setter Property="Background" Value="#45475a" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#89dceb" />
      <Setter Property="Foreground" Value="#11111b" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1e1e2e" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.card:pointerover">
      <Setter Property="Background" Value="#313244" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="#1e1e2e" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </Window.Styles>

  <LayoutTransformControl>
    <LayoutTransformControl.LayoutTransform>
      <ScaleTransform ScaleX="{Binding LayoutScale}" ScaleY="{Binding LayoutScale}" />
    </LayoutTransformControl.LayoutTransform>

    <DockPanel Margin="0,28,0,0">
      <!-- Status -->
      <Border DockPanel.Dock="Bottom" Background="#181825" Padding="24,8"
              BorderBrush="#313244" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding StatusMessage}" Foreground="#6c7086" FontSize="12"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding ScaleSummary}" Foreground="#585b70" FontSize="11"
                     Margin="16,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- Nav -->
      <Border DockPanel.Dock="Bottom" Background="#1e1e2e" Padding="24,12"
              BorderBrush="#313244" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Image Source="/Assets/logo-256.png" Width="28" Height="28" />
            <TextBlock Text="MosaicShell" FontWeight="SemiBold" FontSize="14"
                       Foreground="#cdd6f4" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <Button Classes="nav" Content="Discover"
                    Classes.active="{Binding IsDiscover}"
                    Command="{Binding NavigateCommand}" CommandParameter="Discover" />
            <Button Classes="nav" Content="Library"
                    Classes.active="{Binding IsLibrary}"
                    Command="{Binding NavigateCommand}" CommandParameter="Library" />
            <Button Classes="nav" Content="Settings"
                    Classes.active="{Binding IsSettings}"
                    Command="{Binding NavigateCommand}" CommandParameter="Settings" />
          </StackPanel>
          <Button Grid.Column="2" Classes="action" Content="GitHub"
                  Command="{Binding OpenGitHubCommand}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Grid Margin="40,20">
        <!-- Discover -->
        <DockPanel IsVisible="{Binding IsDiscover}">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <Image Source="/Assets/logo-256.png" Width="48" Height="48" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Discover" FontSize="28" FontWeight="SemiBold" Foreground="#cdd6f4" />
                <TextBlock Text="Compose your desktop from modules and widgets." Foreground="#a6adc8" FontSize="13" />
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Classes="action" Content="Check catalog"
                    Command="{Binding CheckUpdatesCommand}" VerticalAlignment="Center" />
          </Grid>
          <ItemsControl ItemsSource="{Binding DiscoverCards}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" Rows="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DiscoverCard">
                <Border Classes="card" Margin="8" MinHeight="150" PointerPressed="OnDiscoverCardPressed">
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*">
                    <Image Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Top"
                           Source="{Binding IconPath}" />
                    <StackPanel Grid.Column="1" Spacing="8">
                      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Foreground="#cdd6f4" />
                      <TextBlock Text="{Binding Body}" FontSize="13" Foreground="#a6adc8" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>

        <!-- Library -->
        <DockPanel IsVisible="{Binding IsLibrary}">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="Library" FontSize="28" FontWeight="SemiBold" Foreground="#cdd6f4" />
              <TextBlock Text="Install → ▶ launch native overlay → ■ stop. Checkbox + Batch installs multiple. − uninstalls."
                         Foreground="#6c7086" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Classes="action" Content="Batch install" Command="{Binding BatchInstallCommand}" />
              <Button Classes="action" Content="Refresh"
                      Command="{Binding NavigateCommand}" CommandParameter="Library" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,24,*">
            <DockPanel Grid.Column="0">
              <TextBlock DockPanel.Dock="Top" Text="Modules" FontSize="16" FontWeight="SemiBold"
                         Foreground="#cdd6f4" Margin="0,0,0,8" />
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Modules}"
                              x:Name="ModulesList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LibraryItemViewModel">
                      <Border Classes="row">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                          <CheckBox IsChecked="{Binding IsSelectedForBatch}" VerticalAlignment="Center" Margin="0,0,8,0" />
                          <Image Grid.Column="1" Width="32" Height="32" Margin="0,0,12,0"
                                 Source="{Binding IconPath}" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#cdd6f4" />
                              <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#a6adc8" />
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#6c7086"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                          </StackPanel>
                          <Button Grid.Column="3" Classes="action" MinWidth="36" Padding="8,6" Margin="0,0,6,0"
                                  Content="−"
                                  Command="{Binding #Root.((vm:MainViewModel)DataContext).UninstallModuleCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="Uninstall" />
                          <Button Grid.Column="4" Classes="primary" MinWidth="40" Padding="10,6"
                                  Content="{Binding ActionGlyph}"
                                  IsEnabled="{Binding !IsInstalling}"
                                  Command="{Binding #Root.((vm:MainViewModel)DataContext).InstallModuleCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="Install / launch / stop" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
            <DockPanel Grid.Column="2">
              <TextBlock DockPanel.Dock="Top" Text="Widgets" FontSize="16" FontWeight="SemiBold"
                         Foreground="#cdd6f4" Margin="0,0,0,8" />
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Widgets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LibraryItemViewModel">
                      <Border Classes="row">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                          <CheckBox IsChecked="{Binding IsSelectedForBatch}" VerticalAlignment="Center" Margin="0,0,8,0" />
                          <Image Grid.Column="1" Width="32" Height="32" Margin="0,0,12,0"
                                 Source="{Binding IconPath}" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#cdd6f4" />
                              <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#a6adc8" />
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#6c7086"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                          </StackPanel>
                          <Button Grid.Column="3" Classes="action" MinWidth="36" Padding="8,6" Margin="0,0,6,0"
                                  Content="−"
                                  Command="{Binding #Root.((vm:MainViewModel)DataContext).UninstallModuleCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="Uninstall" />
                          <Button Grid.Column="4" Classes="primary" MinWidth="40" Padding="10,6"
                                  Content="{Binding ActionGlyph}"
                                  IsEnabled="{Binding !IsInstalling}"
                                  Command="{Binding #Root.((vm:MainViewModel)DataContext).InstallModuleCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="Install / launch / stop" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Grid>
        </DockPanel>

        <!-- Settings -->
        <StackPanel IsVisible="{Binding IsSettings}" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
            <Image Source="/Assets/logo-256.png" Width="40" Height="40" />
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Foreground="#cdd6f4"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Services probe" FontSize="14" FontWeight="SemiBold" Foreground="#cdd6f4" />
          <TextBlock Text="{Binding ServiceProbe}" Foreground="#a6adc8" TextWrapping="Wrap" />
          <TextBlock Text="UI scale" FontSize="14" FontWeight="SemiBold" Foreground="#cdd6f4" Margin="0,12,0,0" />
          <TextBlock Text="{Binding ScaleSummary}" Foreground="#a6adc8" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Slider Width="280" Minimum="0.75" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True"
                    Value="{Binding UserScale}" />
            <Button Classes="primary" Content="Apply" Command="{Binding ApplyUserScaleCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="action" Content="Match Windows" Command="{Binding MatchWindowsCommand}" />
            <Button Classes="action" Content="Re-detect DPI" Command="{Binding RedetectDpiCommand}" />
          </StackPanel>
          <TextBlock Text="Chrono module settings" FontSize="14" FontWeight="SemiBold" Foreground="#cdd6f4" Margin="0,16,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="140" Text="{Binding ChronoStyle}" Watermark="Style (Center/Minimal)" />
            <CheckBox Content="Seconds" IsChecked="{Binding ChronoSeconds}" VerticalAlignment="Center" />
            <Button Classes="action" Content="Save" Command="{Binding SaveChronoSettingsCommand}" />
          </StackPanel>
          <TextBlock Text="Startup" FontSize="14" FontWeight="SemiBold" Foreground="#cdd6f4" Margin="0,16,0,0" />
          <Button Classes="action" Content="{Binding AutostartEnabled, StringFormat=Autostart: {0}}"
                  Command="{Binding ToggleAutostartCommand}" HorizontalAlignment="Left" />
          <TextBlock Text="Updates" FontSize="14" FontWeight="SemiBold" Foreground="#cdd6f4" Margin="0,16,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="action" Content="Check GitHub releases" Command="{Binding CheckUpdatesCommand}" />
            <TextBlock Text="{Binding UpdateStatus}" Foreground="#a6adc8" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="%LocalAppData%\MosaicShell" Foreground="#6c7086" FontSize="12" Margin="0,16,0,0" />
        </StackPanel>

        <!-- Welcome -->
        <StackPanel IsVisible="{Binding IsWelcome}" Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
          <Image Source="/Assets/logo-hero.png" MaxWidth="280" HorizontalAlignment="Left" />
          <TextBlock Text="Welcome" FontSize="28" FontWeight="SemiBold" Foreground="#cdd6f4" />
          <TextBlock TextWrapping="Wrap" Foreground="#a6adc8" FontSize="14" LineHeight="22"
                     Text="Native host — no Rainmeter. Open Library, check modules to batch-install, then finish welcome. Overlays restore after restart." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Finish welcome" Command="{Binding CompleteWelcomeCommand}" />
            <Button Classes="action" Content="Open Library" Command="{Binding NavigateCommand}" CommandParameter="Library" />
          </StackPanel>
        </StackPanel>

        <!-- About -->
        <StackPanel IsVisible="{Binding IsAbout}" Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <Image Source="/Assets/logo-256.png" Width="72" Height="72" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="MosaicShell" FontSize="28" FontWeight="SemiBold" Foreground="#cdd6f4" />
              <TextBlock Text="Your desktop, composed." Foreground="#89dceb" FontSize="14" />
            </StackPanel>
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Foreground="#a6adc8" FontSize="14" LineHeight="22"
                     Text="Native Avalonia hub + OS services + tile overlays. Packages are assets/settings — not Rainmeter entrypoints. Prefer Mosaicist over iwr|iex." />
          <Button Classes="action" Content="View on GitHub" HorizontalAlignment="Left"
                  Command="{Binding OpenGitHubCommand}" />
        </StackPanel>
      </Grid>
    </DockPanel>
  </LayoutTransformControl>
</Window>
