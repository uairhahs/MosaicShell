<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MosaicShell.Host.ViewModels"
        xmlns:tessera="using:MosaicShell.Host.Tiles.Tessera"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
        x:Class="MosaicShell.Host.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainViewModel"
        Width="1100" Height="750"
        MinWidth="780" MinHeight="560"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        ExtendClientAreaToDecorationsHint="True"
        Icon="avares://MosaicShell.Host/Assets/mosaicshell.ico"
        Title="MosaicShell">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon /template/ ContentPresenter">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.accentSwatch">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.accentSwatch:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.accentSwatch.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <!-- Home cards and library row bodies are real Buttons (focus, keyboard, automation, pressed state). -->
    <Style Selector="Button.card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.card:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.libraryHit">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.libraryHit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.libraryHit:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Margin" Value="0,0,0,14" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.sectionHint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <!-- Motion looks -->
    <Style Selector="Button.motionCard">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <Style Selector="Button.motionCard /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.motionCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.motionCard Border.motionFace">
      <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Button.motionCard:pointerover Border.motionFace">
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
    </Style>
    <Style Selector="Button.motionCard Border.motionFace.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="RadioButton.motionDir">
      <Setter Property="MinWidth" Value="84" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <!-- Readable NumericUpDown sizing -->
    <Style Selector="NumericUpDown.config">
      <Setter Property="MinWidth" Value="168" />
      <Setter Property="Width" Value="180" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="ShowButtonSpinner" Value="True" />
      <Setter Property="AllowSpin" Value="True" />
    </Style>
    <Style Selector="NumericUpDown.config /template/ TextBox#PART_TextBox">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="0,28,0,0">
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" Padding="24,8"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="{Binding UndoLabel}" Padding="10,2" FontSize="12" Margin="12,0,0,0"
                IsVisible="{Binding CanUndoRemove}"
                Command="{Binding UndoRemoveCommand}" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="24,12"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="avares://MosaicShell.Host/Assets/MosaicShell.png" Width="28" Height="28"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="MosaicShell" FontWeight="SemiBold" FontSize="14"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
          <Button Classes="nav" Content="Home"
                  Classes.active="{Binding IsHome}"
                  Command="{Binding NavigateCommand}" CommandParameter="Home" />
          <Button Classes="nav" Content="Settings"
                  Classes.active="{Binding IsSettings}"
                  Command="{Binding NavigateCommand}" CommandParameter="Settings" />
        </StackPanel>
        <Button Grid.Column="2" Content="GitHub"
                Command="{Binding OpenGitHubCommand}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Page body: Home/Tiles/… vs unscaled full-width Settings -->
    <Grid ClipToBounds="True">
      <Grid IsVisible="{Binding !IsSettings}" Margin="40,20"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <!-- Home -->
          <DockPanel IsVisible="{Binding IsHome}">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Image Source="avares://MosaicShell.Host/Assets/MosaicShell.png" Width="48" Height="48"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Home" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <TextBlock Text="Compose your desktop from modules and widgets." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" />
                </StackPanel>
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding HomeCards}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Top">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DiscoverCard">
                  <!-- Content-sized cards, do not stretch to fill a tall window -->
                  <Button Classes="card" VerticalAlignment="Top"
                          Padding="20,18"
                          Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenCardCommand}"
                          CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Title}"
                          AutomationProperties.HelpText="{Binding Body}">
                    <Grid ColumnDefinitions="Auto,*">
                      <Border Width="48" Height="48" CornerRadius="12" Margin="0,0,20,0"
                              Background="{DynamicResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                        <icons:MaterialIcon Kind="{Binding GlyphKind}" Width="26" Height="26"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="{Binding GlyphBrush}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding Body}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>

        <!-- Tiles -->
        <DockPanel IsVisible="{Binding IsTiles}">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
            <Button Command="{Binding GoBackCommand}"
                    VerticalAlignment="Center" Margin="0,0,16,0" Padding="10,8"
                    ToolTip.Tip="Back">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <icons:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
                <TextBlock Text="Back" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Tiles" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              <TextBlock Text="Capabilities: install, arm/disarm background hosts. Widgets: play/stop overlays. Cog opens tile settings."
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Content="Batch install" Command="{Binding BatchInstallCommand}" />
              <Button Content="Refresh"
                      Command="{Binding NavigateCommand}" CommandParameter="Tiles" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,24,*">
            <DockPanel Grid.Column="0">
              <TextBlock DockPanel.Dock="Top" Text="Modules" FontSize="16" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8" />
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Modules}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LibraryItemViewModel">
                      <Border Classes="row">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                          <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForBatch}" VerticalAlignment="Center" Margin="0,0,6,0" />
                          <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Margin="0,0,8,0"
                                  Background="{DynamicResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <icons:MaterialIcon Kind="{Binding GlyphKind}" Width="20" Height="20"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Foreground="{Binding GlyphBrush}" />
                          </Border>
                          <Button Grid.Column="2" Classes="libraryHit"
                                  Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenModuleConfigCommand}"
                                  CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding SettingsAutomationName}"
                                  ToolTip.Tip="Settings">
                            <StackPanel VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                <icons:MaterialIcon Kind="Cog" Width="16" Height="16" Margin="0,0,4,0"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}" FontSize="12"
                                           Foreground="{Binding StatusBrush}"
                                           VerticalAlignment="Center" />
                              </StackPanel>
                              <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                         TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                          </Button>
                          <Button Grid.Column="3" Classes="icon" Margin="0,0,6,0"
                                  IsVisible="{Binding IsInstalled}"
                                  Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveModuleCommand}"
                                  CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding RemoveAutomationName}"
                                  ToolTip.Tip="Remove">
                            <icons:MaterialIcon Kind="Minus" Width="18" Height="18" />
                          </Button>
                          <Button Grid.Column="4" Classes="icon accent"
                                  IsEnabled="{Binding !IsInstalling}"
                                  Command="{Binding #Root.((vm:MainViewModel)DataContext).InstallModuleCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="{Binding ActionToolTip}">
                            <icons:MaterialIcon Kind="{Binding ActionIcon}" Width="18" Height="18" />
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
            <DockPanel Grid.Column="2">
              <TextBlock DockPanel.Dock="Top" Text="Widgets" FontSize="16" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8" />
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Widgets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LibraryItemViewModel">
                      <Border Classes="row">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                          <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForBatch}" VerticalAlignment="Center" Margin="0,0,6,0" />
                          <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Margin="0,0,8,0"
                                  Background="{DynamicResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                            <icons:MaterialIcon Kind="{Binding GlyphKind}" Width="20" Height="20"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Foreground="{Binding GlyphBrush}" />
                          </Border>
                          <Button Grid.Column="2" Classes="libraryHit"
                                  Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenModuleConfigCommand}"
                                  CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding SettingsAutomationName}"
                                  ToolTip.Tip="Settings">
                            <StackPanel VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                <icons:MaterialIcon Kind="Cog" Width="16" Height="16" Margin="0,0,4,0"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}" FontSize="12"
                                           Foreground="{Binding StatusBrush}"
                                           VerticalAlignment="Center" />
                              </StackPanel>
                              <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                         TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                          </Button>
                          <Button Grid.Column="3" Classes="icon" Margin="0,0,6,0"
                                  IsVisible="{Binding IsInstalled}"
                                  Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveModuleCommand}"
                                  CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding RemoveAutomationName}"
                                  ToolTip.Tip="Remove">
                            <icons:MaterialIcon Kind="Minus" Width="18" Height="18" />
                          </Button>
                          <Button Grid.Column="4" Classes="icon accent"
                                  IsEnabled="{Binding !IsInstalling}"
                                  Command="{Binding #Root.((vm:MainViewModel)DataContext).InstallModuleCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="{Binding ActionToolTip}">
                            <icons:MaterialIcon Kind="{Binding ActionIcon}" Width="18" Height="18" />
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Grid>
        </DockPanel>

        <!-- Module config (from tile cog) -->
        <DockPanel IsVisible="{Binding IsModuleConfig}">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,16">
            <Button Command="{Binding GoBackCommand}"
                    VerticalAlignment="Center" Margin="0,0,16,0" Padding="10,8"
                    ToolTip.Tip="Back to Tiles">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <icons:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
                <TextBlock Text="Back" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0} settings">
                    <Binding Path="ConfigModuleTitle" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
          </Grid>

          <!-- Tessera vs other modules (single fill slot, avoids DockPanel starving Tessera) -->
          <Grid>
          <!-- Tessera: left = scrolling settings; right = full-height Appearance; Save / Try now pinned bottom -->
          <Grid IsVisible="{Binding ShowTesseraExtras}"
                RowDefinitions="*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,*">
            <DockPanel Margin="0,0,16,0">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Stretch" Margin="0,0,8,8" Spacing="0">
                  <TextBlock Classes="sectionTitle" Text="Additional settings" Margin="0,0,0,8" />

                  <Border Classes="section">
                    <StackPanel Spacing="12">
                      <TextBlock Classes="sectionTitle" Text="Placement" />
                      <TextBlock Classes="sectionHint"
                                 Text="Where the flyout sits on the chosen monitor’s work area (default: top left, like JaxCore). Insets are pixels from that edge." />
                      <StackPanel Spacing="4">
                        <TextBlock Text="Corner" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <ComboBox MinWidth="200" HorizontalAlignment="Left"
                                  ItemsSource="{Binding TesseraPositionChoices}"
                                  SelectedItem="{Binding SelectedTesseraPosition}"
                                  ToolTip.Tip="Nine-point anchor: top/center/bottom × left/center/right" />
                      </StackPanel>
                      <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Monitor" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                          <NumericUpDown Classes="config" Minimum="1" Maximum="8"
                                         FormatString="0" Value="{Binding TesseraMonitorIndex}"
                                         ToolTip.Tip="1 = primary display; 2+ follow Avalonia screen order" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock Text="Horizontal inset (px)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                          <NumericUpDown Classes="config" Minimum="0" Maximum="200"
                                         FormatString="0" Value="{Binding TesseraXPad}"
                                         ToolTip.Tip="Pixels from the left or right edge of the work area" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock Text="Vertical inset (px)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                          <NumericUpDown Classes="config" Minimum="0" Maximum="200"
                                         FormatString="0" Value="{Binding TesseraYPad}"
                                         ToolTip.Tip="Pixels from the top or bottom edge of the work area" />
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Classes="section">
                    <StackPanel Spacing="12">
                      <TextBlock Classes="sectionTitle" Text="Timing" />
                      <TextBlock Classes="sectionHint" Text="How long the flyout stays visible after the last change (hover holds it open)." />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumericUpDown Classes="config" Minimum="0.5" Maximum="20" Increment="0.25"
                                       FormatString="0.##" Value="{Binding TesseraAutoDismissSeconds}" />
                        <TextBlock Text="seconds" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border x:Name="MotionSection" Classes="section">
                    <StackPanel Spacing="14">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Classes="sectionTitle" Text="Motion" />
                          <TextBlock Classes="sectionHint" Margin="0"
                                     Text="How the flyout arrives and leaves. Pick a look, then fine tune it below." />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Play on screen" VerticalAlignment="Top"
                                Command="{Binding PreviewTesseraFlyoutCommand}"
                                ToolTip.Tip="Save these settings and play a volume flyout on the desktop" />
                      </Grid>

                      <!-- What it will look like -->
                      <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" CornerRadius="10" Padding="12">
                        <Grid ColumnDefinitions="260,*">
                          <tessera:TesseraMotionPreview Width="260" VerticalAlignment="Center"
                                                        Ani="{Binding TesseraMotionCurrent.Ani}"
                                                        AniSteps="{Binding TesseraMotionCurrent.AniSteps}"
                                                        AniEase="{Binding TesseraMotionCurrent.AniEase}"
                                                        AniDir="{Binding TesseraMotionCurrent.AniDir}"
                                                        DisplacementPx="{Binding TesseraMotionCurrent.DisplacementPx}" />
                          <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding TesseraMotionPresetName}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding TesseraMotionSummary}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0">
                              <Run Text="{Binding TesseraMotionDurationLabel}" />
                              <Run Text="·" />
                              <Run Text="{Binding TesseraMotionDistanceLabel}" />
                            </TextBlock>
                          </StackPanel>
                        </Grid>
                      </Border>

                      <!-- The looks, each playing live -->
                      <ItemsControl ItemsSource="{Binding TesseraMotionPresetItems}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TesseraMotionPresetItem">
                            <Button Classes="motionCard"
                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectTesseraMotionPresetCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding Description}">
                              <Border Classes="motionFace" Classes.selected="{Binding IsSelected}">
                                <StackPanel Spacing="6">
                                  <tessera:TesseraMotionPreview IsHitTestVisible="False"
                                                                Ani="{Binding Ani}"
                                                                AniSteps="{Binding AniSteps}"
                                                                AniEase="{Binding AniEase}"
                                                                AniDir="{Binding AniDir}"
                                                                DisplacementPx="{Binding DisplacementPx}" />
                                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                              </Border>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Expander Classes="motionFold" Header="Fine tune" HorizontalAlignment="Stretch" Background="Transparent">
                        <StackPanel Spacing="16" Margin="0,8,0,0">
                          <StackPanel Orientation="Horizontal" Spacing="24">
                            <ToggleSwitch OnContent="Slides in" OffContent="Fades only"
                                          IsChecked="{Binding TesseraMotionSlides}"
                                          ToolTip.Tip="Off: the flyout stays put and fades in and out" />
                            <ToggleSwitch OnContent="Reveals the media strip" OffContent="No media reveal"
                                          IsChecked="{Binding TesseraMotionRevealsMedia}"
                                          IsEnabled="{Binding TesseraMotionRevealEnabled}"
                                          ToolTip.Tip="After the slide, the media strip grows in beneath the volume bar" />
                          </StackPanel>

                          <StackPanel Spacing="4" IsEnabled="{Binding TesseraMotionSlides}">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="Speed" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                              <TextBlock Grid.Column="1" Text="{Binding TesseraMotionDurationLabel}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" />
                            </Grid>
                            <Slider Minimum="160" Maximum="640" SmallChange="16" LargeChange="64" TickFrequency="16"
                                    IsSnapToTickEnabled="True" Value="{Binding TesseraMotionDurationMs}" />
                            <Grid ColumnDefinitions="*,*">
                              <TextBlock Text="Faster" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                              <TextBlock Grid.Column="1" Text="Slower" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                          </StackPanel>

                          <StackPanel Spacing="4" IsEnabled="{Binding TesseraMotionSlides}">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="Distance" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                              <TextBlock Grid.Column="1" Text="{Binding TesseraMotionDistanceLabel}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" />
                            </Grid>
                            <Slider Minimum="10" Maximum="200" SmallChange="5" LargeChange="20" TickFrequency="5"
                                    IsSnapToTickEnabled="True" Value="{Binding TesseraAnimationDisplacement}" />
                            <Grid ColumnDefinitions="*,*">
                              <TextBlock Text="Short" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                              <TextBlock Grid.Column="1" Text="Far" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                          </StackPanel>

                          <StackPanel Spacing="6" IsEnabled="{Binding TesseraMotionSlides}">
                            <TextBlock Text="Slides in from" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <StackPanel Orientation="Horizontal">
                              <RadioButton Classes="motionDir" GroupName="TesseraMotionFrom" Content="← Left"
                                           IsChecked="{Binding TesseraMotionFromLeft}" />
                              <RadioButton Classes="motionDir" GroupName="TesseraMotionFrom" Content="→ Right"
                                           IsChecked="{Binding TesseraMotionFromRight}" />
                              <RadioButton Classes="motionDir" GroupName="TesseraMotionFrom" Content="↑ Top"
                                           IsChecked="{Binding TesseraMotionFromTop}" />
                              <RadioButton Classes="motionDir" GroupName="TesseraMotionFrom" Content="↓ Bottom"
                                           IsChecked="{Binding TesseraMotionFromBottom}" />
                            </StackPanel>
                          </StackPanel>

                          <StackPanel Spacing="4">
                            <TextBlock Text="Feel" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <ComboBox MinWidth="220" HorizontalAlignment="Left"
                                      ItemsSource="{Binding TesseraMotionCurves}"
                                      SelectedItem="{Binding SelectedTesseraMotionCurve}"
                                      ToolTip.Tip="How the movement speeds up and settles. The preview above plays exactly this curve." />
                          </StackPanel>

                          <Expander Classes="motionFold" Header="All curves" HorizontalAlignment="Stretch" Background="Transparent">
                            <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                              <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="Family" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding TesseraEaseFamilies}"
                                          SelectedItem="{Binding TesseraEaseFamily}" />
                              </StackPanel>
                              <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0"
                                          IsVisible="{Binding TesseraEaseVariantEnabled}">
                                <TextBlock Text="Shape" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding TesseraEaseVariants}"
                                          SelectedItem="{Binding TesseraEaseVariant}"
                                          ToolTip.Tip="In: slow start. Out: slow finish. InOut: both." />
                              </StackPanel>
                            </Grid>
                          </Expander>
                        </StackPanel>
                      </Expander>
                    </StackPanel>
                  </Border>

                  <Border Classes="section">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="sectionTitle" Text="What to show" />
                      <TextBlock Classes="sectionHint" Text="Which system events open a Tessera flyout." />
                      <CheckBox Content="Media flyouts (now playing)" IsChecked="{Binding TesseraMediaFlyouts}"
                                ToolTip.Tip="Show a flyout when SMTC media session changes" />
                      <CheckBox Content="Media strip on volume flyout" IsChecked="{Binding TesseraMediaStrip}"
                                ToolTip.Tip="When media is playing, show transport controls next to volume" />
                      <CheckBox Content="Lock-key flyouts (Caps / Num / Scroll)" IsChecked="{Binding TesseraLockFlyouts}" />
                      <CheckBox Content="Airplane-mode flyouts" IsChecked="{Binding TesseraFlightFlyouts}" />
                    </StackPanel>
                  </Border>

                  <Border Classes="section" Margin="0">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="sectionTitle" Text="Advanced" />
                      <CheckBox Content="Legacy volume key hooks" IsChecked="{Binding TesseraLegacyVol}"
                                ToolTip.Tip="Intercept volume keys so Tessera owns the gesture (recommended on Win11)" />
                      <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding TesseraLegacyVol}">
                        <TextBlock Text="Volume step" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <NumericUpDown Classes="config" Minimum="1" Maximum="25" Increment="1"
                                       FormatString="0" Value="{Binding TesseraLegacyStepPercent}"
                                       ToolTip.Tip="Percent points per legacy volume key press (e.g. 2 = ±2%)" />
                        <TextBlock Text="/ 100" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="13" />
                      </StackPanel>
                      <TextBlock Classes="sectionHint" Margin="0"
                                 Text="{x:Static vm:PlatformTexts.NativePopups}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>

            <!-- Full-height right: Appearance (ScrollViewer beside cards, like Additional settings) -->
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel HorizontalAlignment="Stretch" Margin="0,0,8,8" Spacing="0">
                <TextBlock Classes="sectionTitle" Text="Appearance" Margin="0,0,0,8" />

                <Border Classes="section">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="sectionHint" Margin="0"
                               Text="Pick a template. Live scaled preview below. Try now opens it on the desktop." />
                    <ComboBox MinWidth="220" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding ModuleStyleOptions}"
                              SelectedItem="{Binding SelectedModuleStyle}" />
                    <TextBlock Text="Saves on Try now / Save"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
                    <tessera:TesseraStylePreview IsVisible="{Binding TesseraConfigPreviewReady}"
                                                 StyleId="{Binding ModuleStyle}"
                                                 ShowMediaStrip="{Binding TesseraMediaStrip}"
                                                 AccentColor="{Binding TesseraAccentHex}" />
                  </StackPanel>
                </Border>

                <Border Classes="section" Margin="0">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="sectionTitle" Text="More appearance" Margin="0" />
                    <TextBlock Classes="sectionHint" Margin="0"
                               Text="Host material language: soft frost tint (not native translucency). Optional baked wash is a light MagickMeter-style texture." />
                    <StackPanel Spacing="8">
                      <TextBlock Text="Accent colour" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                      <ItemsControl ItemsSource="{Binding TesseraAccentSwatches}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TesseraAccentSwatchVm">
                            <Button Classes="accentSwatch"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).SelectTesseraAccentCommand}"
                                    CommandParameter="{Binding Hex}"
                                    ToolTip.Tip="{Binding Name}">
                              <Panel Width="20" Height="20">
                                <Ellipse Width="20" Height="20" Fill="{Binding Fill}" />
                                <icons:MaterialIcon Kind="Palette" Width="11" Height="11"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                    IsVisible="{Binding IsSystem}" />
                              </Panel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBox Classes="config" Text="{Binding TesseraAccentHex}"
                               PlaceholderText="{x:Static vm:PlatformTexts.AccentPlaceholder}"
                               ToolTip.Tip="Hex accent used by every Tessera style (sliders, play, toggles, highlights). Empty = system accent." />
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Text="Material" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                      <ComboBox MinWidth="220" HorizontalAlignment="Left"
                                ItemsSource="{Binding TesseraMaterialOptions}"
                                SelectedItem="{Binding SelectedTesseraMaterial}"
                                IsEnabled="{Binding TesseraMaterialSelectable}"
                                ToolTip.Tip="Solid: a dense panel. Frosted: Tessera's own translucent frost, drawn by the app. Native Translucency: the operating system blurs the desktop behind the card (acrylic on Windows 11, KWin blur on KDE Plasma); listed only where the system can draw it. After switching Native Translucency on Windows, restart Host so the corner radius applies." />
                      <TextBlock Text="{Binding TesseraMaterialFixedNote}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"
                                 TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Left"
                                 IsVisible="{Binding !TesseraMaterialSelectable}" />
                    </StackPanel>
                    <CheckBox Content="Subtle desktop dim (Focus)" IsChecked="{Binding TesseraFocusDim}"
                              ToolTip.Tip="Very light dim behind the flyout. Never blocks input; outside click dismisses instantly." />
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                      <TextBlock Text="Flyout scale %" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                      <NumericUpDown Classes="config" Minimum="50" Maximum="150" Increment="5"
                                     FormatString="0" Value="{Binding TesseraFlyoutScalePercent}"
                                     ToolTip.Tip="Size multiplier for Tessera flyouts on the desktop (100 = default)." />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
            </Grid>

            <Border Grid.Row="1" Classes="section" Margin="0,8,0,0" Padding="16,12">
              <Grid ColumnDefinitions="Auto,*">
                <Button Classes="accent" Content="Save"
                        Command="{Binding SaveModuleConfigCommand}" />
                <Button Grid.Column="1" Content="Try Now"
                        HorizontalAlignment="Right"
                        Command="{Binding PreviewTesseraFlyoutCommand}"
                        ToolTip.Tip="Save placement/style and preview a volume flyout on the desktop" />
              </Grid>
            </Border>
          </Grid>

          <!-- Non-Tessera modules: how-to + appearance + Save -->
          <DockPanel IsVisible="{Binding !ShowTesseraExtras}">
            <Border DockPanel.Dock="Bottom" Classes="section" Margin="0,8,0,0" Padding="16,12">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="accent" Content="Save" HorizontalAlignment="Left"
                        Command="{Binding SaveModuleConfigCommand}" />
                <Button Content="Try Now"
                        IsVisible="{Binding ConfigCanTryOverlay}"
                        Command="{Binding TryCapabilityOverlayCommand}"
                        ToolTip.Tip="Arm (if needed) and open the overlay so you can see what this module does" />
              </StackPanel>
            </Border>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="12" Margin="0,0,8,8">
                <Border Classes="section" IsVisible="{Binding ConfigCanTryOverlay}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="sectionTitle" Text="What this does" Margin="0" />
                    <TextBlock Text="{Binding ConfigUsageSummary}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14" />
                    <TextBlock Text="{Binding ConfigHowToTrigger}" TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="13" />
                  </StackPanel>
                </Border>

                <Border Classes="section" IsVisible="{Binding ShowHotkeyCapExtras}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="sectionTitle" Text="Hotkey" Margin="0" />
                    <TextBlock Classes="sectionHint" Margin="0"
                               Text="{x:Static vm:PlatformTexts.ReservedShortcuts}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="12,8" MinWidth="160"
                              BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <TextBlock Text="{Binding ConfigHotkeyGesture}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                      </Border>
                      <Button Classes="accent" Content="Capture"
                              Command="{Binding BeginHotkeyCaptureCommand}"
                              IsVisible="{Binding !IsCapturingHotkey}" />
                      <Button Content="Cancel"
                              Command="{Binding CancelHotkeyCaptureCommand}"
                              IsVisible="{Binding IsCapturingHotkey}" />
                    </StackPanel>
                    <TextBlock Text="{Binding HotkeyCaptureHint}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="12" />

                    <StackPanel Spacing="8" IsVisible="{Binding ShowInlayPins}" Margin="0,8,0,0">
                      <TextBlock Classes="sectionTitle" Text="Pins" Margin="0" />
                      <TextBlock Classes="sectionHint" Margin="0"
                                 Text="Search apps, Start Menu shortcuts, or Settings pages, then Add." />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <AutoCompleteBox Width="320" MinimumPrefixLength="0"
                                         FilterMode="ContainsOrdinal"
                                         ItemsSource="{Binding LaunchTargetChoices}"
                                         Text="{Binding LaunchTargetQuery}"
                                         PlaceholderText="Search targets…" />
                        <Button Content="Add pin"
                                Command="{Binding AddLaunchTargetPinCommand}" />
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding ConfigPins}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <DockPanel Margin="0,2">
                              <Button DockPanel.Dock="Right" Classes="icon"
                                      Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveConfigPinCommand}"
                                      CommandParameter="{Binding}"
                                      ToolTip.Tip="Remove">
                                <icons:MaterialIcon Kind="Close" Width="16" Height="16" />
                              </Button>
                              <TextBlock Text="{Binding}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </DockPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding ShowChordActions}" Margin="0,8,0,0">
                      <TextBlock Classes="sectionTitle" Text="Actions" Margin="0" />
                      <TextBlock Classes="sectionHint" Margin="0"
                                 Text="Optional display name + search a launch target." />
                      <TextBox Width="200" HorizontalAlignment="Left" PlaceholderText="Action name (optional)"
                               Text="{Binding ChordActionName}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <AutoCompleteBox Width="320" MinimumPrefixLength="0"
                                         FilterMode="ContainsOrdinal"
                                         ItemsSource="{Binding LaunchTargetChoices}"
                                         Text="{Binding LaunchTargetQuery}"
                                         PlaceholderText="Search targets…" />
                        <Button Content="Add action"
                                Command="{Binding AddChordActionFromPickerCommand}" />
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding ConfigChordActions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ChordActionRow">
                            <DockPanel Margin="0,2">
                              <Button DockPanel.Dock="Right" Classes="icon"
                                      Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveChordActionCommand}"
                                      CommandParameter="{Binding}"
                                      ToolTip.Tip="Remove">
                                <icons:MaterialIcon Kind="Close" Width="16" Height="16" />
                              </Button>
                              <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </DockPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <CheckBox Content="Show mute tile" IsChecked="{Binding ConfigShowMute}"
                              IsVisible="{Binding ShowSubstrateMute}" />
                  </StackPanel>
                </Border>

                <Border Classes="section" VerticalAlignment="Top">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="sectionTitle" Text="Appearance" Margin="0" />
                    <TextBlock Classes="sectionHint" Margin="0"
                               Text="StyleCatalog id. Full visual skins are later." />
                    <ComboBox MinWidth="220" HorizontalAlignment="Left"
                              ItemsSource="{Binding ModuleStyleOptions}"
                              SelectedItem="{Binding SelectedModuleStyle}" />
                    <StackPanel Spacing="8" IsVisible="{Binding ShowChronoExtras}">
                      <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
                      <CheckBox Content="Show seconds" IsChecked="{Binding ChronoSeconds}" />
                    </StackPanel>
                    <StackPanel Spacing="8" IsVisible="{Binding ShowSlateExtras}">
                      <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
                      <TextBlock Text="Idle timeout (seconds)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                      <NumericUpDown Classes="config" Minimum="30" Maximum="3600" FormatString="0"
                                     Value="{Binding ConfigIdleSeconds}" />
                      <CheckBox Content="Hide when foreground app is fullscreen"
                                IsChecked="{Binding ConfigHideOnFullscreen}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
          </Grid>
        </DockPanel>

        <!-- Welcome -->
        <StackPanel IsVisible="{Binding IsWelcome}" Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
          <Button Command="{Binding GoBackCommand}"
                  HorizontalAlignment="Left" IsVisible="{Binding ShowBackButton}" Padding="10,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <icons:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
              <TextBlock Text="Back" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Image Source="avares://MosaicShell.Host/Assets/MosaicShell.png" MaxWidth="280" HorizontalAlignment="Left"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="Welcome" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock Text="Your desktop, composed." Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="14" />
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" LineHeight="22"
                     Text="Install the tiles you want, then arm capabilities like Tessera or Mixdeck so they run from the tray Host. Widgets open as overlays when you launch them from Tiles." />
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="13" LineHeight="20"
                     Text="Open Tiles to pick modules (use the checkboxes, then Batch install). When you are ready, finish welcome to land on Home. Closing the hub can keep the Host in the tray; settings control that." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="Finish welcome" Command="{Binding CompleteWelcomeCommand}" />
            <Button Content="Open Tiles" Command="{Binding NavigateCommand}" CommandParameter="Tiles" />
          </StackPanel>
        </StackPanel>

        <!-- About -->
        <StackPanel IsVisible="{Binding IsAbout}" Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
          <Button Command="{Binding GoBackCommand}"
                  HorizontalAlignment="Left" Padding="10,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <icons:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
              <TextBlock Text="Back" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel Orientation="Horizontal" Spacing="16">
            <Image Source="avares://MosaicShell.Host/Assets/MosaicShell.png" Width="72" Height="72"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="MosaicShell" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              <TextBlock Text="Your desktop, composed." Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="14" />
              <TextBlock Text="{Binding HostBuildLabel, StringFormat=Build {0}}"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" LineHeight="22"
                     Text="{x:Static vm:PlatformTexts.About}" />
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" LineHeight="22"
                     Text="Built as an Avalonia rewrite of the JaxCore / Rainmeter era, with the same idea of composable surfaces, without Rainmeter or .rmskin installs. Tessera and Mixdeck are first-party capabilities; widgets run as native overlays." />
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="13" LineHeight="20"
                     Text="Honest about fidelity: flagship layouts work; pixel-perfect Jax-Core parity is still iterative. Issues and modules welcome on GitHub." />
          <Button Content="View on GitHub" HorizontalAlignment="Left"
                  Command="{Binding OpenGitHubCommand}" />
        </StackPanel>
        </Grid>

      <DockPanel IsVisible="{Binding IsSettings}" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="40,8,40,16">
        <Image Source="avares://MosaicShell.Host/Assets/MosaicShell.png" Width="40" Height="40"
               RenderOptions.BitmapInterpolationMode="HighQuality" />
        <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   VerticalAlignment="Center" />
      </StackPanel>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalAlignment="Stretch">
        <StackPanel Spacing="0" HorizontalAlignment="Stretch">

          <Border Classes="section" Margin="40,0,40,0">
            <StackPanel Spacing="8">
              <TextBlock Classes="sectionTitle" Text="Services" />
              <TextBlock Classes="sectionHint"
                         Text="Live probe of audio, metrics, media, and armed capabilities." />
              <TextBlock Text="{Binding ServiceProbe}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="section" Margin="40,0,40,0">
            <StackPanel Spacing="10">
              <TextBlock Classes="sectionTitle" Text="Window close" />
              <TextBlock Classes="sectionHint"
                         Text="What the window close button does. Tray menu Exit always quits and stops tiles." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Minimize to tray"
                        Command="{Binding SetCloseMinimizesToTrayCommand}" CommandParameter="tray"
                        Classes.active="{Binding CloseMinimizesToTray}" />
                <Button Content="Exit application"
                        Command="{Binding SetCloseMinimizesToTrayCommand}" CommandParameter="exit"
                        Classes.active="{Binding !CloseMinimizesToTray}" />
              </StackPanel>
              <TextBlock IsVisible="{Binding CloseMinimizesToTray}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                         Text="Close hides the hub; capabilities keep running in the tray." />
              <TextBlock IsVisible="{Binding !CloseMinimizesToTray}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                         Text="Close exits MosaicShell and stops armed tiles." />
            </StackPanel>
          </Border>

          <Border Classes="section" Margin="40,0,40,0">
            <StackPanel Spacing="10">
              <TextBlock Classes="sectionTitle" Text="Startup" />
              <TextBlock Classes="sectionHint"
                         Text="{x:Static vm:PlatformTexts.Autostart}" />
              <ToggleSwitch Content="Start MosaicShell when I sign in"
                            IsChecked="{Binding AutostartEnabled, Mode=OneWay}"
                            Command="{Binding ToggleAutostartCommand}" />
            </StackPanel>
          </Border>

          <Border Classes="section" Margin="40,0,40,0">
            <StackPanel Spacing="10">
              <TextBlock Classes="sectionTitle" Text="Updates" />
              <TextBlock Classes="sectionHint"
                         Text="Compare the installed host build against the latest GitHub release (date+build tags)." />
              <TextBlock Text="{Binding HostBuildLabel, StringFormat=Installed build: {0}}"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Check for updates" Command="{Binding CheckUpdatesCommand}" />
                <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="section" Margin="40,0,40,16">
            <StackPanel Spacing="8">
              <TextBlock Classes="sectionTitle" Text="Data location" />
              <TextBlock Classes="sectionHint"
                         Text="Settings, modules and saved window positions live here." />
              <Grid ColumnDefinitions="*,Auto">
                <SelectableTextBlock Text="{Binding DataFolderPath}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"
                                     FontFamily="Cascadia Mono, Consolas, monospace" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Open folder" Margin="12,0,0,0" Click="OnOpenDataFolderClicked" />
              </Grid>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
      </DockPanel>

      <!-- Remove confirmation, only for modules MosaicShell cannot bring back (ModuleRemovalPolicy.ConfirmFirst). -->
      <Border IsVisible="{Binding HasPendingRemoval}"
              Background="{DynamicResource SmokeFillColorDefaultBrush}">
        <Border Classes="section" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="12">
            <TextBlock Classes="sectionTitle" Text="{Binding PendingRemovalTitle}" />
            <TextBlock Text="{Binding PendingRemovalBody}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="Cancel" IsCancel="True" Command="{Binding CancelRemoveCommand}" />
              <Button Classes="accent" Content="Remove" Command="{Binding ConfirmRemoveCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </DockPanel>
</Window>