<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mp="using:MosaicShell.Host.ViewModels.ModulePage"
             xmlns:core="using:MosaicShell.Core.Modules.Settings"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MosaicShell.Host.Views.ModulePageView"
             x:DataType="mp:ModulePageViewModel">

  <!--
    One page for every module that has a Core schema. Rows follow one anatomy: label and description on the left,
    the control on the right (lists sit under their label). A row the desktop cannot do is greyed out with Core's line.
  -->
  <UserControl.Styles>
    <Style Selector="TextBlock.rowLabel">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.rowHint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.rowNote">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- A text button: Remove and the sign-in start offer are actions in a sentence, not primary buttons. -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.link:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorTertiaryBrush}" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="mp:ToggleRowViewModel">
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsVisible}" Margin="0,4">
        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Classes="rowLabel" Text="{Binding Label}" />
          <TextBlock Classes="rowHint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
          <TextBlock Classes="rowNote" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
          <TextBlock Classes="rowNote" Text="{Binding UnavailableReason}" IsVisible="{Binding !IsAvailable}" />
        </StackPanel>
        <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center"
                      IsChecked="{Binding Value}" IsEnabled="{Binding IsAvailable}"
                      AutomationProperties.Name="{Binding Label}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="mp:ChoiceRowViewModel">
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsVisible}" Margin="0,4">
        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Classes="rowLabel" Text="{Binding Label}" />
          <TextBlock Classes="rowHint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
          <TextBlock Classes="rowNote" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
          <TextBlock Classes="rowNote" Text="{Binding UnavailableReason}" IsVisible="{Binding !IsAvailable}" />
        </StackPanel>
        <ComboBox Grid.Column="1" MinWidth="200" VerticalAlignment="Center"
                  ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                  IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{Binding Label}">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="core:SettingOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="mp:NumberRowViewModel">
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsVisible}" Margin="0,4">
        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Classes="rowLabel" Text="{Binding Label}" />
          <TextBlock Classes="rowHint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
          <TextBlock Classes="rowNote" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
          <TextBlock Classes="rowNote" Text="{Binding UnavailableReason}" IsVisible="{Binding !IsAvailable}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                    IsEnabled="{Binding IsAvailable}">
          <Slider Width="220" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                  SmallChange="{Binding Step}" LargeChange="{Binding Step}" TickFrequency="{Binding Step}"
                  IsSnapToTickEnabled="True" Value="{Binding Value}"
                  AutomationProperties.Name="{Binding Label}" />
          <TextBlock Text="{Binding ValueText}" MinWidth="56" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="mp:HotkeyRowViewModel">
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsVisible}" Margin="0,4">
        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Classes="rowLabel" Text="{Binding Label}" />
          <TextBlock Classes="rowHint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
          <TextBlock Classes="rowNote" Text="{Binding UnavailableReason}" IsVisible="{Binding !IsAvailable}" />
          <TextBlock Classes="rowNote" Text="{Binding Hint}" IsVisible="{Binding IsAvailable}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    IsEnabled="{Binding IsAvailable}">
          <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,6"
                  MinWidth="120" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <TextBlock Text="{Binding Gesture}" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          </Border>
          <Button Content="Change" Command="{Binding BeginCaptureCommand}" IsVisible="{Binding !IsCapturing}"
                  AutomationProperties.Name="{Binding Label}" />
          <Button Content="Cancel" Command="{Binding CancelCaptureCommand}" IsVisible="{Binding IsCapturing}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="mp:TextListRowViewModel">
      <StackPanel Spacing="8" IsVisible="{Binding IsVisible}" Margin="0,4">
        <TextBlock Classes="rowLabel" Text="{Binding Label}" />
        <TextBlock Classes="rowHint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding IsAvailable}">
          <AutoCompleteBox Width="320" MinimumPrefixLength="0" FilterMode="ContainsOrdinal"
                           ItemsSource="{Binding Choices}" Text="{Binding Query}"
                           PlaceholderText="Search apps" AutomationProperties.Name="{Binding Label}" />
          <Button Content="Add" Command="{Binding AddCommand}" />
        </StackPanel>
        <TextBlock Classes="rowNote" Text="Nothing here yet." IsVisible="{Binding IsEmpty}" />
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="x:String">
              <DockPanel Margin="0,2">
                <Button DockPanel.Dock="Right" Classes="icon" ToolTip.Tip="Remove"
                        AutomationProperties.Name="Remove"
                        Command="{Binding $parent[ItemsControl].((mp:TextListRowViewModel)DataContext).RemoveCommand}"
                        CommandParameter="{Binding}">
                  <icons:MaterialIcon Kind="Close" Width="16" Height="16" />
                </Button>
                <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="mp:ActionListRowViewModel">
      <StackPanel Spacing="8" IsVisible="{Binding IsVisible}" Margin="0,4">
        <TextBlock Classes="rowLabel" Text="{Binding Label}" />
        <TextBlock Classes="rowHint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding IsAvailable}">
          <TextBox Width="180" PlaceholderText="Name (optional)" Text="{Binding Name}" />
          <AutoCompleteBox Width="280" MinimumPrefixLength="0" FilterMode="ContainsOrdinal"
                           ItemsSource="{Binding Choices}" Text="{Binding Query}"
                           PlaceholderText="Search apps" AutomationProperties.Name="{Binding Label}" />
          <Button Content="Add" Command="{Binding AddCommand}" />
        </StackPanel>
        <TextBlock Classes="rowNote" Text="Nothing here yet." IsVisible="{Binding IsEmpty}" />
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="core:SettingPair">
              <DockPanel Margin="0,2">
                <Button DockPanel.Dock="Right" Classes="icon" ToolTip.Tip="Remove"
                        AutomationProperties.Name="Remove"
                        Command="{Binding $parent[ItemsControl].((mp:ActionListRowViewModel)DataContext).RemoveCommand}"
                        CommandParameter="{Binding}">
                  <icons:MaterialIcon Kind="Close" Width="16" Height="16" />
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12" Margin="0,0,8,16" MaxWidth="820" HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4" Margin="0,0,16,0">
          <TextBlock Classes="rowHint" FontSize="14" Text="{Binding Summary}" />
          <TextBlock Classes="rowNote" Text="{Binding HowTo}" IsVisible="{Binding HasHowTo}" />
        </StackPanel>
        <Button Grid.Column="1" Content="Show it on screen" VerticalAlignment="Top"
                IsVisible="{Binding CanPreview}" Command="{Binding PreviewCommand}" />
      </Grid>

      <Border Classes="section">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Classes="rowLabel" FontWeight="SemiBold" Text="{Binding SwitchLabel}" />
            <TextBlock Classes="rowHint" Text="{Binding SwitchDescription}" />
            <Button Classes="link" Padding="0" Margin="0,4,0,0" HorizontalAlignment="Left"
                    Content="Start MosaicShell when I sign in"
                    IsVisible="{Binding OffersSignInStart}" Command="{Binding TurnOnSignInStartCommand}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center"
                        IsChecked="{Binding IsOn}" IsEnabled="{Binding !IsSwitching}"
                        AutomationProperties.Name="{Binding SwitchLabel}" />
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Sections}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="12" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="mp:SettingSectionViewModel">
            <Border Classes="section">
              <StackPanel Spacing="6">
                <TextBlock Classes="sectionTitle" Text="{Binding Title}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button Classes="link" HorizontalAlignment="Left" Margin="0,4,0,0"
              Content="{Binding RemoveLabel}" Command="{Binding RemoveCommand}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
