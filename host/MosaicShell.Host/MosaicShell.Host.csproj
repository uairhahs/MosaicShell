<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <!-- Canonical logos from .github/res (source of truth) -->
    <AvaloniaResource Include="..\..\.github\res\MosaicShell.png" Link="Assets\MosaicShell.png" />
    <AvaloniaResource Include="..\..\.github\res\logo-variants\compact-512.png" Link="Assets\logo-512.png" />
    <AvaloniaResource Include="..\..\.github\res\logo-variants\compact-256.png" Link="Assets\logo-256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.7" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.7" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.7" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.7" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Material.Icons.Avalonia" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MosaicShell.Core\MosaicShell.Core.csproj" />
  </ItemGroup>

  <!--
    CreateAppHost copies Win32 resources from the Avalonia-rewritten DLL into apphost.exe.
    If MosaicShell.Host.exe is still running (tray), that PE can be truncated mid-write and
    the next build fails with MSB4018 BadImageFormatException "Image is too small".
  -->
  <Target Name="StopRunningHostBeforeCreateAppHost"
          BeforeTargets="CreateAppHost"
          Condition="'$(OS)' == 'Windows_NT' and '$(Configuration)' == 'Debug'">
    <Exec Command="taskkill /F /IM MosaicShell.Host.exe /T &gt;NUL 2&gt;&amp;1 &amp; exit /B 0"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low" />
  </Target>

  <Target Name="EnsureAppHostSourceAssemblyIsValid" BeforeTargets="CreateAppHost">
    <PropertyGroup>
      <_AppHostSourceDll Condition="Exists('$(IntermediateOutputPath)Avalonia\$(TargetName)$(TargetExt)')">$(IntermediateOutputPath)Avalonia\$(TargetName)$(TargetExt)</_AppHostSourceDll>
      <_AppHostSourceDll Condition="'$(_AppHostSourceDll)' == ''">$(IntermediateOutputPath)$(TargetName)$(TargetExt)</_AppHostSourceDll>
    </PropertyGroup>
    <Error
      Condition="Exists('$(_AppHostSourceDll)') And $([System.IO.FileInfo]::new('$(_AppHostSourceDll)').Length) &lt; 512"
      Text="Intermediate assembly is truncated ($(_AppHostSourceDll)). Close MosaicShell.Host, then run: dotnet clean --project MosaicShell.Host &amp;&amp; dotnet build --project MosaicShell.Host" />
  </Target>
</Project>
