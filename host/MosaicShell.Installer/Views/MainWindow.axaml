<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MosaicShell.Installer.ViewModels"
        x:Class="MosaicShell.Installer.Views.MainWindow"
        x:DataType="vm:InstallerViewModel"
        Width="720" Height="520"
        MinWidth="640" MinHeight="440"
        Background="#11111b"
        Icon="avares://MosaicShell.Installer/Assets/mosaicshell.ico"
        Title="MosaicShell Setup"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#89b4fa" />
      <Setter Property="Foreground" Value="#11111b" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Background" Value="#313244" />
      <Setter Property="Foreground" Value="#cdd6f4" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#a6adc8" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="Foreground" Value="#cdd6f4" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1e1e2e" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="28">
    <Border DockPanel.Dock="Bottom" Padding="0,16,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding StatusMessage}" Classes="muted" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1" Classes="action" Content="Back" Margin="0,0,8,0"
                Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" />
        <Button Grid.Column="2" Classes="primary" Content="Next"
                Command="{Binding NextCommand}"
                IsVisible="{Binding !IsFinish}"
                IsEnabled="{Binding CanGoNext}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    IsVisible="{Binding IsFinish}">
          <Button Classes="primary" Content="Launch MosaicShell"
                  Command="{Binding LaunchHostCommand}"
                  IsVisible="{Binding InstallSucceeded}" />
          <Button Classes="action" Content="Close" Command="{Binding ExitCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Welcome -->
    <StackPanel IsVisible="{Binding IsWelcome}" Spacing="14">
      <Image Source="avares://MosaicShell.Installer/Assets/MosaicShell.png"
             Width="72" Height="72" HorizontalAlignment="Left"
             RenderOptions.BitmapInterpolationMode="HighQuality" />
      <TextBlock Text="MosaicShell Setup" Classes="title" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Install the Host, Mosaicist, and tile stubs from this release bundle." />
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding VersionLabel, StringFormat=Version: {0}}" Foreground="#cdd6f4" />
          <TextBlock Text="{Binding BundleRoot, StringFormat=Bundle: {0}}" Classes="muted" TextWrapping="Wrap" />
          <TextBox Text="{Binding BundleRoot}" PlaceholderText="Release folder (Host*/Mosaicist/Tiles)" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="action" Content="Download latest from GitHub"
                    Command="{Binding DownloadLatestCommand}"
                    IsEnabled="{Binding !IsDownloading}" />
            <TextBox Width="220" Text="{Binding GitHubRepository}"
                     PlaceholderText="owner/repo" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding !CanGoNext}"
                     Text="Place MosaicShell.Installer next to Host (or Host-fw), Mosaicist, and Tiles, paste an extracted zip path, or download the latest release." />
          <TextBlock Text="{Binding ErrorMessage}" Foreground="#f38ba8" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Install type -->
    <StackPanel IsVisible="{Binding IsInstallType}" Spacing="14">
      <TextBlock Text="Install type" Classes="title" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Framework-dependent is smaller but needs the .NET 10 Desktop Runtime. Self-contained is larger and includes the runtime." />
      <Border Classes="card">
        <StackPanel Spacing="10">
          <RadioButton GroupName="Variant" Content="Use installed .NET 10 Desktop Runtime (smaller)"
                       IsChecked="{Binding !UseSelfContained}" />
          <RadioButton GroupName="Variant" Content="Include runtime (self-contained, larger)"
                       IsChecked="{Binding UseSelfContained}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Runtime check -->
    <StackPanel IsVisible="{Binding IsRuntimeCheck}" Spacing="14">
      <TextBlock Text="Runtime check" Classes="title" />
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding RuntimeStatus}" TextWrapping="Wrap" Foreground="#cdd6f4" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="action" Content="Refresh" Command="{Binding RefreshRuntimeCommand}" />
            <Button Classes="action" Content="Open download page"
                    Command="{Binding OpenRuntimeDownloadCommand}"
                    IsVisible="{Binding !RuntimeOk}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Location -->
    <StackPanel IsVisible="{Binding IsLocation}" Spacing="14">
      <TextBlock Text="Install location" Classes="title" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Host, Mosaicist, and Tiles are copied here. Module data stays under %LocalAppData%\MosaicShell." />
      <TextBox Text="{Binding TargetDirectory}" PlaceholderText="Install folder" />
    </StackPanel>

    <!-- Modules -->
    <DockPanel IsVisible="{Binding IsModules}">
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
        <TextBlock Text="Modules" Classes="title" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Select tiles to install now. You can add more later from the Host library." />
      </StackPanel>
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Modules}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ModulePickItem">
              <Border Classes="card" Margin="0,0,0,8">
                <CheckBox IsChecked="{Binding IsSelected}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding DisplayName}" Foreground="#cdd6f4" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
                  </StackPanel>
                </CheckBox>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- Options -->
    <StackPanel IsVisible="{Binding IsOptions}" Spacing="14">
      <TextBlock Text="Options" Classes="title" />
      <Border Classes="card">
        <StackPanel Spacing="10">
          <CheckBox Content="Create Start Menu shortcut"
                    IsChecked="{Binding CreateStartMenuShortcut}" />
          <CheckBox Content="Launch Host at logon (tray-only)"
                    IsChecked="{Binding EnableLogonAutostart}" />
        </StackPanel>
      </Border>
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Click Next to start copying files and installing selected modules." />
    </StackPanel>

    <!-- Progress -->
    <StackPanel IsVisible="{Binding IsProgress}" Spacing="14" VerticalAlignment="Center">
      <TextBlock Text="Installing…" Classes="title" />
      <ProgressBar Value="{Binding ProgressFraction}" Minimum="0" Maximum="1" Height="10" />
      <TextBlock Text="{Binding ProgressDetail}" Classes="muted" />
    </StackPanel>

    <!-- Finish -->
    <StackPanel IsVisible="{Binding IsFinish}" Spacing="14">
      <TextBlock Text="Setup complete" Classes="title" IsVisible="{Binding InstallSucceeded}" />
      <TextBlock Text="Setup failed" Classes="title" IsVisible="{Binding !InstallSucceeded}" />
      <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#f38ba8" TextWrapping="Wrap"
                 IsVisible="{Binding !InstallSucceeded}" />
    </StackPanel>
  </DockPanel>
</Window>
